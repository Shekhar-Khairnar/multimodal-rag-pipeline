# Copy this file to .env and fill in your values. Never commit .env.

OPENROUTER_API_KEY=
PINECONE_API_KEY=

# Model IDs from https://openrouter.ai/models
# VISION_MODEL must support image input (filter by "image" input modality).
# Using the same ID for both is fine if that model handles images.
TEXT_MODEL=
VISION_MODEL=

# Optional overrides (defaults live in src/mmrag/config.py)
# PINECONE_INDEX_NAME=multimodal-rag
# PINECONE_NAMESPACE=documents
# TOP_K=5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # ~10x faster on CPU, weaker on tables
